  "description": "LCode 嵌入式固件开发 Agent 桌面网关（阶段2 W1 骨架）",
  "author": "neasonli",
  "license": "MIT",
  "main": "out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
