# ========== LLM 配置（OpenAI 兼容格式，切换模型只改这里） ==========
# DeepSeek: https://api.deepseek.com/v1  |  Ollama 本地: http://localhost:11434/v1
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1  |  OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# ========== Embedding / RAG ==========
# 默认 bge-small-zh-v1.5（快）；英文手册多可换 BAAI/bge-m3（需重建向量库）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_TOP_K=5
# HuggingFace 下载镜像（国内默认 hf-mirror.com；可改 https://huggingface.co）
HF_ENDPOINT=https://hf-mirror.com

# 知识库后端（可选）：
#   auto（默认）= 装了私有知识库包 lcode-kb 就用它，否则通用模式（stub，检索返回空）
#   private     = 必须用私有包（装不上直接报错，生产/授权环境用）
#   stub        = 强制通用模式（调试/离线；旧值 local 等价）
# LCODE_KB_BACKEND=auto

# ========== 编译（ESP-IDF） ==========
# IDF_PATH: ESP-IDF 源码目录（export.bat 所在目录）
# IDF_TOOLS_PATH: 工具目录（含工具链/CMake，默认 %USERPROFILE%\.espressif）
# IDF_PYTHON_ENV_PATH: IDF Python 虚拟环境目录（python_env\Scripts\python.exe 的父目录）
IDF_PATH=
IDF_TOOLS_PATH=
IDF_PYTHON_ENV_PATH=
IDF_TARGET=esp32s3

# ========== 服务 ==========
HOST=127.0.0.1
PORT=8000
