{
  "name": "@lcode/planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "L-CODE 规划器（阶段3 Phase1 落地）：DeepSeek Harness headless 裁剪装配 + 内核工具包装器 + 本地 HTTP 服务",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "setup": "node scripts/setup-profile.mjs",
    "dsh": "node --import tsx/esm ../../deepseek/deepseek-harness-master/apps/cli/src/bin.ts",
    "oneshot": "pnpm dsh --profile lcode-planner"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/cordis-plugin-timer": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-llm-deepseek": "*",
    "@deepseek-ai/dsh-llm-retry": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-persistence-jsonl": "*",
    "@deepseek-ai/dsh-session-checkpoint-policy": "*",
    "@deepseek-ai/dsh-session-projection": "*",
    "@deepseek-ai/dsh-token-meter": "*",
    "@deepseek-ai/dsh-compaction-basic": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-agent-loop": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-settings-file": "*",
    "@deepseek-ai/dsh-credentials-local": "*",
    "@deepseek-ai/dsh-goal": "*",
    "@deepseek-ai/dsh-tool-goal": "*",
    "@deepseek-ai/dsh-goal-round-driver": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-skill-filesystem": "*",
    "@deepseek-ai/dsh-tool-skill": "*",
    "@deepseek-ai/dsh-sandbox": "*",
    "@deepseek-ai/dsh-sandbox-local": "*",
    "@deepseek-ai/dsh-sandbox-policy": "*",
    "@deepseek-ai/dsh-user-approval": "*",
    "@deepseek-ai/dsh-repeat-tool-reminder": "*",
    "@deepseek-ai/dsh-tool-call-timeout-policy": "*",
    "@deepseek-ai/dsh-fs-sandbox": "*",
    "@deepseek-ai/dsh-fs-observation-policy": "*",
    "@deepseek-ai/dsh-tool-fs": "*",
    "@deepseek-ai/dsh-tool-todo": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-subagent-fork-in-process": "*",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "*",
    "@deepseek-ai/dsh-tool-subagent": "*",
    "@deepseek-ai/dsh-tool-subagent-control": "*",
    "@deepseek-ai/dsh-tool-subagent-report": "*",
    "@deepseek-ai/dsh-workflow": "*",
    "@deepseek-ai/dsh-workflow-worker-thread": "*",
    "@deepseek-ai/dsh-tool-workflow": "*",
    "@deepseek-ai/dsh-tool-ralph": "*",
    "@deepseek-ai/dsh-plan-mode": "*",
    "@deepseek-ai/dsh-user-questions": "*",
    "@deepseek-ai/dsh-cmdline": "*"
  }
